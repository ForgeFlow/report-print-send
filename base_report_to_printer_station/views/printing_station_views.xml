<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="printing_station_view_tree" model="ir.ui.view">
        <field name="model">printing.station</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="printer_id" />
            </tree>
        </field>
    </record>
    <record id="printing_station_view_form" model="ir.ui.view">
        <field name="model">printing.station</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_register_computer"
                        type="object"
                        string="Register this computer"
                        class="oe_highlight"
                        groups="base_report_to_printer.printing_group_manager"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Single 1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="printer_id" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Registered Computers" name="tokens">
                            <field name="token_ids">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="registered_by_id" />
                                    <field name="create_date" string="Registered On" />
                                    <field name="last_seen" />
                                    <button
                                        name="action_revoke"
                                        type="object"
                                        string="Revoke"
                                        icon="fa-ban"
                                    />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="printing_station_action" model="ir.actions.act_window">
        <field name="name">Print Stations</field>
        <field name="res_model">printing.station</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="printing_station_menu"
        name="Print Stations"
        action="printing_station_action"
        parent="base_report_to_printer.printing_menu"
        sequence="30"
    />
</odoo>
